# Headers for the page and its files.
#
# Cloudflare serves these straight from the asset store without running the
# Worker, so anything the Worker sets never reaches them. For a long time that
# meant the page itself went out with no Content-Security-Policy, no framing
# protection and no HSTS, while the code that "set" them sat unreached.
# Keep this in step with the fallback in worker.ts.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Vite names these files after their contents, so a given URL never changes.
# Without this the phone re-checks every one of them on every load — and iOS
# reloads the page each time it has thrown the tab away.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
